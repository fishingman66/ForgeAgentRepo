# ---- 必填: 数据库与缓存密码 ----
MYSQL_ROOT_PASSWORD=Forge1234
REDIS_PASSWORD=Forge1234

# ---- 可选: 端口与资源 ----
# 前端对外端口
WEB_PORT=80
# 后端 JVM 参数
JAVA_OPTS=-Xms512m -Xmx1g -XX:+UseZGC

# ---- 监控端点 Basic 凭据(上线前务必覆盖) ----
# 与 backend/pom.xml 的 monitor.username/password 出厂值一致;
# compose 同时用于 /actuator/health 探针与应用的 Basic 鉴权,两者读同一组变量,
# 修改后不会出现探针 401 导致 backend 一直 unhealthy。
MONITOR_USERNAME=forge
MONITOR_PASSWORD=123456

# ---- 演示模式 ----
# true = 在线演示环境: 后端开启写保护, 前端登录页显示「演示账号一键登录」
# false = 正常部署
DEMO_ENABLED=false

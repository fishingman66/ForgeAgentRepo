    "@wangeditor-next/editor": "^6.5.1",
    "@wangeditor-next/editor-for-vue": "^6.5.1",
    "animate.css": "^4.1.1",
    "await-to-js": "^3.0.0",
    "axios": "^1.21.0",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.8",
    "highlight.js": "^11.12.0",
    "image-conversion": "^2.1.1",
    "jsencrypt": "^3.5.4",
    "markdown-it": "^15.0.3",
    "nprogress": "^0.2.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-cropper": "^1.1.4",

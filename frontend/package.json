    "@unocss/preset-wind3": "^66.12.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/compiler-sfc": "^3.5.45",
    "autoprefixer": "^10.6.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "sass": "^1.108.1",
    "typescript": "^6.0.3",

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.forgeagent.agent.mapper.AgentMarketListingMapper">

    <select id="selectPublisherNames" resultType="java.util.HashMap">
        select u.user_id as id, u.nick_name as name
        from sys_user u
        where u.del_flag = '0'
          and u.user_id in
        <foreach collection="userIds" item="uid" open="(" separator="," close=")">#{uid}</foreach>
    </select>

</mapper>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.forgeagent</groupId>
        <artifactId>forge-modules</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>forge-agent-core</artifactId>
    <description>
        Agent 平台共享内核(Agent/模型/空间成员/附件实体与映射、权限助手、配置缓存、模型工厂)
    </description>
    <dependencies>
        <!-- 通用工具 -->
        <dependency>
            <groupId>com.forgeagent</groupId>
            <artifactId>forge-common-core</artifactId>
        </dependency>

        <!-- 数据库服务 -->
        <dependency>
            <groupId>com.forgeagent</groupId>
            <artifactId>forge-common-mybatis</artifactId>
        </dependency>

        <!-- 缓存服务(配置缓存 @Cacheable) -->
        <dependency>
            <groupId>com.forgeagent</groupId>
            <artifactId>forge-common-redis</artifactId>
        </dependency>

        <!-- 安全模块(登录用户上下文) -->
        <dependency>
            <groupId>com.forgeagent</groupId>
            <artifactId>forge-common-satoken</artifactId>
        </dependency>
        <!-- 横切加密:API Key 落库加密 TypeHandler -->
        <dependency>
            <groupId>com.forgeagent</groupId>
            <artifactId>forge-common-encrypt</artifactId>
        </dependency>

        <!-- AgentScope Java 运行内核(共享模型工厂) -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope</artifactId>
        </dependency>

        <!-- agentscope 扩展类本身已打进 all-in-one jar,但官方 SDK 未传递引入;
             显式声明后,provider=anthropic/gemini 的原生分支才能构造出真实 Model -->
        <dependency>
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.genai</groupId>
            <artifactId>google-genai</artifactId>
        </dependency>

        <!-- 单元测试(协议路由构造级回归) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
